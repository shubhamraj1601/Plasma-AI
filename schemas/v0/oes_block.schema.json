{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shubhamraj1601/Plasma-AI/schemas/v0/oes_block.schema.json",
  "title": "oes_block v0.1",
  "description": "Block of OES frames, topic oes-spectra. intensities is frame by frame (frame 0 all channels, then frame 1, ...). Its length (frame_count x channels) is checked downstream, not here.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "message_type": { "const": "oes_block" },
    "spectrometer_id": { "type": "string", "minLength": 1 },
    "oes_config_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["lines", "full"] },
    "frame_count": { "type": "integer", "minimum": 1 },
    "frame_interval_us": { "type": "integer", "minimum": 1 },
    "integration_time_ms": { "type": "number" },
    "intensities": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "saturated": { "type": "boolean" }
  },
  "required": [
    "spectrometer_id", "oes_config_id", "mode", "frame_count", "frame_interval_us",
    "integration_time_ms", "intensities", "saturated"
  ],
  "unevaluatedProperties": false
}
